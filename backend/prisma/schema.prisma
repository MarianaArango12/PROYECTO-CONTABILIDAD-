generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Empresa {
  id            String     @id @default(uuid())
  nit           String     @unique
  razonSocial   String
  direccion     String?
  telefono      String?
  email         String?
  activo        Boolean    @default(true)
  creadoEn      DateTime   @default(now())
  actualizadoEn DateTime   @updatedAt

  empleados     Empleado[]
  usuarios      Usuario[]
  obras         Obra[]
}

model Rol {
  id          String    @id @default(uuid())
  nombre      String    @unique
  descripcion String?
  usuarios    Usuario[]
}

model Usuario {
  id                 String    @id @default(uuid())
  nombre             String
  email              String    @unique
  password           String
  activo             Boolean   @default(true)
  creadoEn           DateTime  @default(now())

  rolId              String
  empresaId          String

  novedadesCreadas   Novedad[] @relation("NovedadesCreadas")
  novedadesRevisadas Novedad[] @relation("NovedadesRevisadas")

  empresa            Empresa   @relation(fields: [empresaId], references: [id])
  rol                Rol       @relation(fields: [rolId], references: [id])
}

model Cargo {
  id          String     @id @default(uuid())
  nombre      String     @unique
  descripcion String?
  activo      Boolean    @default(true)

  empleados   Empleado[]
}

model Turno {
  id               String         @id @default(uuid())
  nombre           String         @unique
  descripcion      String?
  horaEntrada      String?
  horaSalida       String?
  horasProgramadas Decimal?       @db.Decimal(5, 2)
  jornada          Decimal?       @db.Decimal(5, 2)
  tipo             TipoTurno
  activo           Boolean        @default(true)
  creadoEn         DateTime       @default(now())
  actualizadoEn    DateTime       @updatedAt

  programaciones   Programacion[]
  obras            Obra[]
}

model Obra {
  id                  String       @id @default(uuid())
  nombre              String
  descripcion         String?
  horasServicio       Decimal      @db.Decimal(5, 2)
  fechaInicio         DateTime
  fechaFin            DateTime?
  activo              Boolean      @default(true)
  creadoEn            DateTime     @default(now())
  actualizadoEn       DateTime     @updatedAt

  empresaId           String
  turnoId             String

  empresa             Empresa      @relation(fields: [empresaId], references: [id])
  turno               Turno        @relation(fields: [turnoId], references: [id])

  contratos           ContratoEmpleado[]
  programaciones      Programacion[]
}

model Empleado {
  id                String         @id @default(uuid())
  nombres            String
  apellidos          String
  documento          String         @unique
  cargo              String?
  salarioBase        Decimal        @db.Decimal(12, 2)
  fechaIngreso       DateTime
  fechaSalida        DateTime?
  motivoSalida       String?
  observacionSalida  String?
  activo              Boolean        @default(true)

  empresaId           String
  cargoId             String?

  cargoCatalogo       Cargo?         @relation(fields: [cargoId], references: [id])
  empresa             Empresa        @relation(fields: [empresaId], references: [id])

  contratos           ContratoEmpleado[]
  nominas             Nomina[]
  novedades           Novedad[]
  programaciones      Programacion[]
}

model ContratoEmpleado {
  id             String         @id @default(uuid())
  tipoContrato   TipoContrato
  fechaInicio    DateTime
  fechaFin       DateTime?
  estado         EstadoContrato @default(ACTIVO)
  observacion    String?
  creadoEn       DateTime       @default(now())
  actualizadoEn  DateTime       @updatedAt

  empleadoId     String
  obraId         String

  empleado       Empleado       @relation(fields: [empleadoId], references: [id])
  obra           Obra           @relation(fields: [obraId], references: [id])

  @@index([empleadoId])
  @@index([obraId])
  @@index([fechaInicio, fechaFin])
}

model Programacion {
  id               String             @id @default(uuid())
  fecha            DateTime
  horaEntrada      String?
  horaSalida       String?
  horasProgramadas Decimal?           @db.Decimal(5, 2)
  estado           EstadoProgramacion @default(PROGRAMADO)
  observacion      String?
  creadoEn         DateTime           @default(now())
  actualizadoEn    DateTime           @updatedAt

  empleadoId       String
  turnoId          String
  obraId           String?

  tipoProgramacion TipoProgramacion   @default(TRABAJO)

  empleado         Empleado           @relation(fields: [empleadoId], references: [id])
  turno            Turno              @relation(fields: [turnoId], references: [id])
  obra              Obra?              @relation(fields: [obraId], references: [id])

  @@unique([empleadoId, fecha])
  @@index([obraId])
}

model Novedad {
  id            String           @id @default(uuid())
  categoria     CategoriaNovedad
  tipo          TipoNovedad
  estado        EstadoNovedad    @default(PENDIENTE)
  fecha         DateTime
  cantidad      Decimal?         @db.Decimal(10, 2)
  observacion   String?
  creadoEn      DateTime         @default(now())
  actualizadoEn DateTime         @updatedAt

  empleadoId    String
  creadoPorId   String
  revisadoPorId String?
  revisadoEn    DateTime?

  creadoPor     Usuario          @relation("NovedadesCreadas", fields: [creadoPorId], references: [id])
  empleado      Empleado         @relation(fields: [empleadoId], references: [id])
  revisadoPor   Usuario?         @relation("NovedadesRevisadas", fields: [revisadoPorId], references: [id])
}

model Nomina {
  id                    String       @id @default(uuid())
  periodoInicio         DateTime
  periodoFin            DateTime
  salarioBase           Decimal      @db.Decimal(12, 2)
  horasExtra            Decimal      @default(0) @db.Decimal(12, 2)
  recargos              Decimal      @default(0) @db.Decimal(12, 2)
  bonificaciones        Decimal      @default(0) @db.Decimal(12, 2)
  descuentos            Decimal      @default(0) @db.Decimal(12, 2)

  auxilioTransporte     Decimal      @default(0) @db.Decimal(12, 2)
  ingresoBaseCotizacion Decimal      @default(0) @db.Decimal(12, 2)
  salud                 Decimal      @default(0) @db.Decimal(12, 2)
  pension               Decimal      @default(0) @db.Decimal(12, 2)

  totalDevengado        Decimal      @db.Decimal(12, 2)
  totalDeducciones      Decimal      @db.Decimal(12, 2)
  netoPagar             Decimal      @db.Decimal(12, 2)

  estado                EstadoNomina @default(PENDIENTE)
  creadoEn              DateTime     @default(now())
  actualizadoEn        DateTime     @updatedAt

  empleadoId            String
  incapacidad           Decimal      @default(0) @db.Decimal(12, 2)

  empleado              Empleado     @relation(fields: [empleadoId], references: [id])

  @@unique([empleadoId, periodoInicio, periodoFin])
}

enum EstadoNomina {
  PENDIENTE
  CALCULADA
  APROBADA
  PAGADA
  ANULADA
}

enum TipoTurno {
  DIA
  NOCHE
  MIXTO
  FIJO
  ROTATIVO
}

enum TipoProgramacion {
  TRABAJO
  DESCANSO
}

enum EstadoProgramacion {
  PROGRAMADO
  CUMPLIDO
  CAMBIO
  AUSENCIA
  CANCELADO
}

enum CategoriaNovedad {
  OPERATIVA
  LABORAL
}

enum EstadoNovedad {
  PENDIENTE
  APROBADA
  RECHAZADA
}

enum TipoNovedad {
  CAMBIO_TURNO
  REPROGRAMACION
  COBERTURA_TURNO
  AUSENCIA_OPERATIVA
  LLEGADA_TARDE
  RETIRO_ANTICIPADO
  CAMBIO_PUESTO
  HORA_EXTRA
  RECARGO
  DOMINICAL
  FESTIVO
  INCAPACIDAD
  PERMISO
  AUSENCIA
  BONIFICACION
  DESCUENTO
  OTRA
  HORA_EXTRA_NOCTURNA
  HORA_EXTRA_DOMINICAL
  HORA_EXTRA_DOMINICAL_NOCTURNA
  HORA_EXTRA_FESTIVA
  HORA_EXTRA_FESTIVA_NOCTURNA
}

enum TipoContrato {
  INDEFINIDO
  FIJO
  OBRA_LABOR
  TEMPORAL
}

enum EstadoContrato {
  ACTIVO
  TERMINADO
  SUSPENDIDO
}
